{
  "name": "aegisai",
  "version": "0.1.0",
  "description": "EU AI Act conformity engine for regulated AI systems — Annex III classification, Annex IV docs, FRIA, post-market monitoring",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aegisai": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/api/server.js",
    "dev": "tsc --watch & node --watch dist/api/server.js",
    "demo:binder": "npm run build && node scripts/generate-demo-binder.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "eu-ai-act",
    "compliance",
    "ai-governance",
    "annex-iv",
    "iso-42001",
    "fria",
    "model-risk-management",
    "regulatory",
    "audit"
  ],
  "author": "AegisAI",
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "@fastify/sensible": "^5.6.0",
    "json-logic-js": "^2.0.5",
    "pino": "^9.4.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/json-logic-js": "^2.0.7",
    "@types/node": "^20.14.10",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.6.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
